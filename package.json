{
  "name": "vue3-vite-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vp dev --mode dev",
    "build": "pnpm run type-check && vp build --mode prod",
    "build:test": "pnpm run type-check && vp build --mode test",
    "build:pre": "pnpm run type-check && vp build --mode pre",
    "preview": "vp preview",
    "type-check": "vue-tsc -b --noEmit",
    "check": "vp check && pnpm run lint:stylelint && pnpm run type-check",
    "lint": "pnpm run lint:stylelint --fix && vp check --fix",
    "lint:stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "fmt": "vp fmt",
    "reinstall": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "prepare": "vp config --no-agent",
    "update:deps": "pnpx taze -i"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.5",
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "pinia": "^4.1.0",
    "vconsole": "^3.15.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  }
}
